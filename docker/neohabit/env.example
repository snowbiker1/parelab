# ═══════════════════════════════════════════════════════════════
#    Neohabit - production-ready .env.example
#    Copy to .env and fill / change values
# ═══════════════════════════════════════════════════════════════

# ─── Required / Critical ────────────────────────────────────────
POSTGRES_USER=neohabit
POSTGRES_DB=neohabit
POSTGRES_PASSWORD=Parelab1!                                     # ← must set!

JWT_SECRET=3c8d1cd5c4bf83eb173c0ab8df88b18c02c5fd3134a40d3504ba77b0a981e9ba       # ← must set! (use 32+ random bytes, base64 recommended)

# ─── Commonly changed ───────────────────────────────────────────
TAG=latest                  # or 1.1.0, sha-abc123, etc.

FRONTEND_PORT=8080

# URL from which you'll be accessing Neohabit from (required for CORS)
# FRONTEND_URL=http://127.0.0.1:8080                  # ← or http://localhost:8080
FRONTEND_URL=https://neohabit.parecloud.ca           # ← for production

LOG_LEVEL=info              # debug | info | warn | error

# ─── Application features ───────────────────────────────────────
DISABLE_SIGNUP=false        # true = no new users (good after creating first account; recommended for prod)
STRICT_USER_FIELDS=false    # true = no short/empty passwords
REQUIRE_EMAIL=false         # true = email mandatory on signup
DEMO=false                  # true = demo version with no login options

# ─── Tuning (optional) ──────────────────────────────────────────
PG_MAX_OPEN_CONNS=20
PG_MAX_LIFETIME=30m
PG_MAX_IDLE_TIME=10m
